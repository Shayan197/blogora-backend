# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# For local development:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/
# DATABASE_NAME=blogora_db
#
# For cloud providers (Render, Neon, Supabase, Railway, AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-1.aws.neon.tech/blogora_db?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/
DATABASE_NAME=blogora_db

# Security & Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production

# CORS / Frontend Allowed Origins
# In development: http://localhost:3000
# In production (Render + Vercel): https://your-frontend-domain.vercel.app
# Supports comma-separated list of origins: https://blogora.vercel.app,http://localhost:3000
DOMAIN=http://localhost:3000

# Email Service (Nodemailer OTP sending)
# Use Google App Password (not your regular account password)
EMAIL=your-email@gmail.com
EMAIL_PASS=your-google-app-password
